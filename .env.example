# Token fine-grained do GitHub SEM nenhuma permissão (só leitura pública), opcional.
# Sem ele a API de repositórios funciona com limite de 60 requisições/hora.
GITHUB_TOKEN=

# URL pública do site, sem barra no fim (ex.: https://seu-dominio). Usada no canonical, hreflang,
# sitemap, robots e Open Graph. Sem ela, as URLs saem com http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Vercel Web Analytics + Speed Insights carregam só quando VERCEL_ENV=production
# (variável de sistema da própria Vercel). Use 1 para desligar os dois.
DISABLE_VERCEL_INSIGHTS=
