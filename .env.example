# Token fine-grained do GitHub SEM nenhuma permissão (só leitura pública), opcional.
# Sem ele a API de repositórios funciona com limite de 60 requisições/hora.
GITHUB_TOKEN=

# URL pública do site, sem barra no fim (ex.: https://seu-dominio). Usada no canonical, hreflang,
# sitemap, robots e Open Graph. Sem ela, as URLs saem com http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Formulário de contato (#26). Sem as quatro primeiras, o formulário não aparece e a página
# Contato mostra só o e-mail e os perfis. Cadastre na Vercel, nunca aqui.
# Chave de API do Resend (resend.com), com permissão só de envio.
RESEND_API_KEY=
# Para onde as mensagens do formulário vão.
CONTACT_TO_EMAIL=
# Chaves do Cloudflare Turnstile (a pública vai para o navegador; a secreta só no servidor).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Opcional: remetente num domínio verificado no Resend, ex.: "Portfólio <contato@seudominio>".
# Sem ele, usa onboarding@resend.dev, que só entrega para o e-mail da conta Resend.
CONTACT_FROM_EMAIL=
